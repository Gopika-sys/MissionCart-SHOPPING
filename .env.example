# Database
DATABASE_URL=jdbc:mysql://localhost:3306/missioncart?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=missioncart
MYSQL_USER=missioncart
MYSQL_PASSWORD=change_me_local_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Spring Profile: 'local' (zero-dependency H2 MySQL-mode) or 'mysql' (MySQL 8 / Docker)
SPRING_PROFILES_ACTIVE=local

# JWT Security (replace with 64+ char random secrets in production)
JWT_SECRET=dev_only_replace_with_secure_256_bit_jwt_secret_key_for_missioncart_access
JWT_REFRESH_SECRET=dev_only_replace_with_secure_256_bit_jwt_refresh_secret_key_for_missioncart

# Admin Bootstrap (only created if configured and no admin exists)
ADMIN_BOOTSTRAP_EMAIL=admin@missioncart.local
ADMIN_BOOTSTRAP_PASSWORD=change_me_admin_bootstrap_password

# AI Providers (optional — deterministic fallback runs automatically when blank)
AI_PROVIDER=fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

# Razorpay Test Mode (optional — explicit local demo checkout runs when blank)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Media Storage (optional — local verified asset storage used when blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# App URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws

# Optional Redis Cache
REDIS_URL=
REDIS_ENABLED=false
